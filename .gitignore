# ============================================================
# Dataset Curator – local/runtime files only
# ============================================================

# Python environments and generated bytecode
curator_env/
curator_env_py313/
.venv/
.venv313/
.venv_*/
venv/
__pycache__/
*.py[cod]
*$py.class

# Secrets and local configuration
.env
.env.*
token.txt
_ui_config.json
_ui_video_config.json
_ui_settings.json
_ui_language_override.json
_active_run_state.json

# Downloaded local vision models (MediaPipe Tasks), fetched on first use
_models/

# Local datasets and generated curator output
Datasets/
curated_*/
*/curated_*/
_cache/
**/_cache/

# Internal tests, regression suites and test assets. Versioned: the unit
# tests directly in tests/ and the synthetic frame-detector suite; other
# local test material in tests/ stays private.
/tests/*
!/tests/__init__.py
!/tests/test_*.py
!/tests/frame_detector/
/tools/
RegressionSuite/
*RegressionSuite*/
frame_regression_*.csv
*_regression_*.csv
test_images/
golden_dataset/

# Internal development documentation
IMPLEMENTATION_REPORT.md
CHANGELOG.md
VERSION.txt

# Logs, temporary files and packaged workspaces
logs/
*.log
*.tmp
*.zip
CHANGELOG*
IMPLEMENTATION*

# Operating-system files
Thumbs.db
Desktop.ini
.DS_Store
